LOCAL_FOLDER_HOST=127.0.0.1
LOCAL_FOLDER_PORT=8765
# Exact extension origins, comma-separated. Never use a wildcard.
CEBIAN_EXTENSION_ORIGINS=chrome-extension://replace-with-extension-id
# LOCAL_FOLDER_DATA_DIR=C:\Users\<you>\AppData\Local\Cebian\LocalFolderService
LOCAL_FOLDER_MAX_CONNECTIONS=32
LOCAL_FOLDER_MAX_MESSAGE_BYTES=16777216
LOCAL_FOLDER_MAX_FILE_BYTES=5242880
LOCAL_FOLDER_MAX_DIRECTORY_ENTRIES=5000
LOCAL_FOLDER_MAX_SEARCH_ENTRIES=20000
LOCAL_FOLDER_MAX_SEARCH_RESULTS=500
LOCAL_FOLDER_MAX_REQUESTS_PER_MINUTE=600
# Demo page port (only used by npm run demo).
# DEMO_PORT=4173
